# ============================================================
# Mix Food - Client (Vite + React)
# Copy this file to .env (dev).
# VITE_API_BASE_URL is inlined at build time.
# ============================================================

# Backend API base URL (dev: http://localhost:3001)
VITE_API_BASE_URL=http://localhost:3001

# Public canonical URL used for SEO metadata (production: https://mix-food.io.vn)
VITE_SITE_URL=https://mix-food.io.vn

# WebSocket URL — usually same as the API base URL.
# Socket.IO connects here for real-time order status updates.
VITE_WS_URL=http://localhost:3001
